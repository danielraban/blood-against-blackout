# Neon pooled or serverless Postgres connection string.
DATABASE_URL=
# Use a long, unique password. Server-only.
ADMIN_PASSWORD=
# At least 32 random bytes, used to sign admin sessions.
ADMIN_SESSION_SECRET=
# At least 32 random bytes. Vercel Cron sends this as a bearer token.
CRON_SECRET=
# Public address for corrections, privacy questions, and takedown requests.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=
# Optional. Local ingest only. Vercel production authenticates AI Gateway with OIDC.
# Create a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=
